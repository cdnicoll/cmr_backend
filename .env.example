# Environment: develop | production
ENVIRONMENT=develop

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_USER_EMAIL=your_user_email
SUPABASE_USER_PASS=your_user_pass

# Database (IPv4-compatible for Modal)
TRANSACTION_POOLER_URL=postgresql://user:pass@host:6543/db

# Recovery worker timeout (minutes)
JOB_STUCK_TIMEOUT_MINUTES=15

# Scraping (optional, default 50)
SCRAPE_MIN_WORD_COUNT=50

# Scraping proxy — residential proxy to avoid cloud IP blocks (e.g. Smartproxy)
# Format: http://username:password@host:port
SCRAPING_PROXY_URL=

# Modal (run `modal setup` first; use `modal token new` if needed)
MODAL_PROJECT=cody-99083
MODAL_APP_NAME=API-develop

