# Environment: develop | production
ENVIRONMENT=develop

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_USER_EMAIL=your_user_email
SUPABASE_USER_PASS=your_user_pass

# Database (IPv4-compatible for Modal)
TRANSACTION_POOLER_URL=postgresql://user:pass@host:6543/db

# Resource-pipeline recovery (stuck scraping/ingesting → failed)
SCRAPE_STUCK_TIMEOUT_MINUTES=15

# Scraping (optional, default 50)
SCRAPE_MIN_WORD_COUNT=50

# Scraping proxy — residential proxy to avoid cloud IP blocks (e.g. Smartproxy)
# Format: http://username:password@host:port
SCRAPING_PROXY_URL=

# Ingestion (Graphiti / knowledge graph)
INGEST_MIN_WORD_COUNT=100
INGEST_STUCK_TIMEOUT_MINUTES=30
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# OpenRouter (Graphiti LLM, embedder, reranker — model set via env)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SMALL_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Discovery (optional — required only for YouTube channel sources)
# Add to Modal secret app-config-{env} for deployed discovery
YOUTUBE_API_KEY=

# Modal (run `modal setup` first; use `modal token new` if needed)
# MODAL_WORKSPACE: expected workspace name — deploy.py validates the active profile matches this
# MODAL_PROJECT: Modal environment name (maps to -e flag in modal deploy)
MODAL_WORKSPACE=canadain-mining-report
MODAL_PROJECT=main
MODAL_APP_NAME=API-develop

# Finance MCP — Bearer token for the TSXV 50 stock data MCP server
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FINANCE_MCP_TOKEN=

